  "db_name": "PostgreSQL",
  "query": "\n        SELECT id,\n               occurred_at,\n               app_slug,\n               actor_type AS \"actor_type: ActorType\",\n               actor_user_id AS \"actor_user_id?\",\n               action,\n               method,\n               path,\n               status_code AS \"status_code?\",\n               request_id\n        FROM audit_events\n        WHERE ($1::text IS NULL OR app_slug = $1)\n          AND ($2::uuid IS NULL OR actor_user_id = $2)\n        ORDER BY occurred_at DESC, id DESC\n        LIMIT $3 OFFSET $4\n        ",
