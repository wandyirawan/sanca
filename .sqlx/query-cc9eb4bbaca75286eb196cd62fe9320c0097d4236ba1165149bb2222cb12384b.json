  "query": "\n        UPDATE users\n        SET display_name = COALESCE($2, display_name),\n            status = COALESCE($3::user_status, status),\n            updated_at = now()\n        WHERE id = $1\n        RETURNING id, email::text AS \"email!\", display_name,\n                  status AS \"status: UserStatus\", is_superadmin, token_version,\n                  created_at, updated_at\n        ",
