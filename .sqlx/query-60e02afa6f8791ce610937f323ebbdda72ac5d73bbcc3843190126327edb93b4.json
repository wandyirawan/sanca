{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT r.id, r.app_id, r.key, r.name, r.description, r.is_system\n        FROM user_roles ur\n        JOIN roles r ON r.id = ur.role_id\n        JOIN apps a  ON a.id = r.app_id\n        WHERE ur.user_id = $1\n        ORDER BY a.slug, r.key\n        ",
