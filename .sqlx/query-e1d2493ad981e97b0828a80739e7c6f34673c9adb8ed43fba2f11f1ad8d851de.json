{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT r.id, r.key, r.name, r.is_system,\n               count(rp.permission_id) AS \"permissions!\"\n        FROM roles r\n        JOIN apps a ON a.id = r.app_id\n        LEFT JOIN role_permissions rp ON rp.role_id = r.id\n        WHERE a.slug = 'core'\n        GROUP BY r.id\n        ORDER BY r.key\n        ",
