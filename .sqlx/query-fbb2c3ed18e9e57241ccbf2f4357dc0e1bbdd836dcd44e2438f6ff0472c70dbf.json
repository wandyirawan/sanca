  "query": "\n        INSERT INTO roles (id, app_id, key, name, description)\n        SELECT $1, a.id, $2, $3, $4\n        FROM apps a\n        WHERE a.slug = 'core'\n        ON CONFLICT (app_id, key) DO NOTHING\n        RETURNING id, key, name, description, is_system\n        ",
