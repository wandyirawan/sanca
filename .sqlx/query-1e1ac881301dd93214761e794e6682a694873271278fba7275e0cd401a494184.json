{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, email::text AS \"email!\", display_name,\n               status AS \"status: UserStatus\", is_superadmin, token_version,\n               created_at, updated_at\n        FROM users\n        WHERE $1::text IS NULL\n           OR email::text ILIKE $1\n           OR display_name ILIKE $1\n        ORDER BY email\n        LIMIT $2 OFFSET $3\n        ",
