{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT code_hash, app_id, user_id, session_id, redirect_uri, scope,\n               code_challenge, challenge_method, expires_at, consumed_at\n        FROM oauth_codes\n        WHERE code_hash = $1\n          AND consumed_at IS NULL\n          AND expires_at > now()\n        ",
