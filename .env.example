# Alamat listen server (host:port).
IAM_BIND=127.0.0.1:8080

# Lingkungan: dev | prod.
SANCA_ENV=dev

# Format log: pretty | json.
SANCA_LOG_FORMAT=pretty

# Direktori file log. Rotasi harian: sanca.<tanggal>.log. Alloy men-tail folder ini.
SANCA_LOG_DIR=/var/log/sanca

# Filter log tracing (default: info).
RUST_LOG=info
